# ElevenLabs API Configuration
# Get your API key at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs Agent ID (Used in 'agent' mode)
# Run `python setup_agent.py` to create one automatically, or paste an existing one here:
ELEVENLABS_AGENT_ID=

# Default Voice ID (e.g., 'JBFqnCBsd6RMkjVDRZzb' for George, '21m00Tcm4TlvDq8ikWAM' for Rachel)
# Run `python main.py --list-voices` to see all available voices
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Anthropic API Configuration (Required for 'pipeline' mode)
# Get your API key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Optional Customizations
ASSISTANT_LANGUAGE=en
MAX_CONVERSATION_SECONDS=180
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v1
TRANSCRIPTS_DIR=transcripts
